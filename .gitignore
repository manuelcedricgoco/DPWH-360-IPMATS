# Dependencies
node_modules/

# Build and test output
dist/
build/
coverage/

# Environment files: real keys stay local; only the .env.example templates are committed
.env
.env.*
!.env.example

# Keys and certificates
*.pem
*.key
*.p12
*.pfx

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# Claude Code personal (non-shared) settings
CLAUDE.local.md
.claude/settings.local.json

# Skills installer working copy (npx skills). The shared copy of each skill is
# committed under .claude/skills/, which is the folder Claude Code reads.
.agents/

# Logs and OS files
*.log
.DS_Store
Thumbs.db
